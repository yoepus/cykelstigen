# Upstash Redis — added automatically if you create the store from the Vercel
# dashboard (Storage → Upstash Redis → Connect Project). Otherwise copy them
# from console.upstash.com → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string. Guards /api/admin and the /admin page.
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=

# Cloudflare Turnstile (free). Leave both blank to run without a captcha —
# the honeypot and rate limit still apply. Get keys at:
# dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for hashing visitor IPs before they touch storage. Any random string.
IP_SALT=

# Shown on the page and used for the "contact me" mail link.
CONTACT_EMAIL=yoed.anise@gmail.com

# --- money ------------------------------------------------------------------
# What the path itself is estimated to cost to build. Shown in the cost table.
BUILD_COST_SEK=150000

# What the campaign raises in total, INCLUDING the match. The progress bar is
# measured against this. 300000 = build + 10 years of fees and upkeep.
GOAL_SEK=300000

# 1:1 match, capped. Set to 0 to remove the match panel's headline figure.
MATCH_CAP_SEK=300000
MATCHER_NAME=Yoed Anise

# --- the association --------------------------------------------------------
# The existing förening the project runs under. Defaults to "Näs Focksta Vänner".
ASSOCIATION_NAME=Näs Focksta Vänner
